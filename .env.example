# Faith-n-Action environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Django core ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True                              # False in production
ALLOWED_HOSTS=localhost,127.0.0.1       # yourdomain.com,www.yourdomain.com in prod

# --- TLS / cookie hardening (True in production, behind nginx) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0                   # 31536000 in prod
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
BEHIND_TLS_PROXY=False                  # True when nginx terminates TLS

# --- performance ---
SESSION_SAVE_EVERY_REQUEST=False        # True forces a DB write per request (PERF-1)
LOG_LEVEL=INFO                          # DEBUG floods debug.log with PII (SEC-4/SEC-12)

# --- payments (PayMongo) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=

# --- email (SendGrid) ---
EMAIL_HOST_USER=                        # from-address
EMAIL_HOST_PASSWORD=                    # SendGrid API key

# --- database ---
# DATABASE_URL=postgres://user:pass@host:5432/kofc   # recommended for production
